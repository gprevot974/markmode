<plist version="1.0">
<dict>
  <!-- markmode://open?path=... is how `mde` opens files, those that don't exist yet included. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>dev.gprevot.markmode</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>markmode</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
